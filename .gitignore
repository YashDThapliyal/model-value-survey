# Python environment and tool caches
.venv/
__pycache__/
*.pyc
.ruff_cache/
.DS_Store

# Secrets, in case any are ever added locally
.env
.env.*
*.token

# The authors' repo is cloned here unmodified (see README); includes their ~2.1 GB of downloaded log-probabilities
vendor/

# Generated per-model log-probability CSVs (~2.8 GB); regenerate with scripts/survey/run_survey.py
data/logprobs/*.csv

# Model weights and Hugging Face cache, in case any land inside the project
*.safetensors
*.bin
*.gguf
*.pt
*.pth
*.ckpt
.cache/
hf_cache/
huggingface/

# Run logs
*.log
runs/logs/
runs/v3/logs/

# Regenerable analysis cache
runs/v2_cache/

# Lists other models in the local Hugging Face cache (machine-specific, not project data)
runs/protected_cache_entries.txt

# Blog draft export
every-model-says-love.pdf

# Generated by scripts/check_access.py (machine-specific memory and disk figures)
access_report.md
